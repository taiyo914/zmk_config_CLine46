#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// タップとホールドの判定
// - 200ms 以上押したときにホールドになる
// - 200ms 以内に別のキーが押されてもホールド判定はしない 
// - 200ms 以内に素早く長押しするとタップのキーを押し続ける

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    macros {
        // Shift で送る文字を変えるための macro 
        // 先に Shift を外してから、引数のキーを送る
        // 同時に送ると、PC が Shift ありの文字を入力することがある

        unshifted: unshifted {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp RSHIFT>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        // Shift の有無で送る文字を変えるキー。Shift ありのときは Shift を外して送る

        semi_colon: semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&unshifted SEMI>;    // 単押し ':' / Shift ';'
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Tab と Q を同時に押すと Esc
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        // 左親指の Space とその右隣を同時に押している間、レイヤー5（設定）に入る
        combo_settings {
            timeout-ms = <50>;
            key-positions = <40 41>;
            bindings = <&mo 5>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 文字入力
        layer_0 {
            bindings = <
&kp TAB      &kp Q       &kp W     &kp E      &kp R            &kp T                                    &kp Y             &kp U   &kp I       &kp O     &kp P          &kp BSPC
&mo 4        &kp A       &kp S     &kp D      &kp F            &kp G                                    &kp H             &kp J   &kp K       &kp L     &kp MINUS      &kp RET
&kp LSHIFT   &kp Z       &kp X     &kp C      &kp V            &kp B                                    &kp N             &kp M   &kp COMMA   &kp DOT   &kp SLASH      &kp RSHIFT
             &kp LCTRL   &none     &kp LALT   &mt LGUI LANG2   &lt 1 SPACE   &mo 2      &mo 3           &mt RGUI LANG1                                  &kp C_VOL_DN   &kp C_VOL_UP
            >;
        };

        // 数字
        layer_1 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &kp N0      &kp N1   &kp N2   &kp N3   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &kp PLUS    &kp N4   &kp N5   &kp N6   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &kp ASTRK   &kp N7   &kp N8   &kp N9   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                                 &trans   &trans
            >;
        };

        // マウス（オートマウスレイヤー）
        layer_2 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &mkp MB4   &trans   &mkp MB5   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &mkp MB1   &mo 6    &mkp MB2   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans     &trans   &trans     &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                                  &trans   &trans
            >;
        };

        // 記号
        // 英語の呼び名の頭文字などで位置を決めている
        //   Q ' quote         W " w-quote    E = equal      R ^ raised to the power of   T ~ tilde
        //   A @ at            S * star       D $ dollar     G ` grave
        //   X ! eXclamation   C : colon      V | vertical   B \ backslash
        //   H # hash          N & 'n (and)   L + large      P % percent
        layer_3 {
            bindings = <
&trans   &kp SQT   &kp DQT     &kp EQUAL     &kp CARET   &kp TILDE                        &trans      &kp LPAR   &kp RPAR   &trans     &kp PRCNT   &trans
&trans   &kp AT    &kp ASTRK   &kp DLLR      &trans      &kp GRAVE                        &kp HASH    &kp LBKT   &kp RBKT   &kp PLUS   &trans      &trans
&trans   &trans    &kp EXCL    &semi_colon   &kp PIPE    &kp BSLH                         &kp AMPS    &trans     &trans     &trans     &trans      &trans
         &trans    &trans      &trans        &trans      &trans      &trans      &trans   &trans                                       &trans      &trans
            >;
        };

        // 移動とショートカット
        //   右手: 矢印キーと削除
        //   左手: A と S はスクリーンショット、D はブラウザの開発者ツール、C は Ctrl+C
        //   右下の2キー: 画面の明るさ
        layer_4 {
            bindings = <
&trans   &trans           &trans               &trans          &trans   &trans                        &kp LG(LEFT)   &kp LA(LEFT)   &kp UP     &kp LA(RIGHT)   &kp LG(RIGHT)   &trans
&trans   &kp LG(LS(N2))   &kp LG(LS(LC(N4)))   &kp LG(LA(I))   &trans   &trans                        &kp BSPC       &kp LEFT       &kp DOWN   &kp RIGHT       &kp DEL         &trans
&trans   &trans           &trans               &kp LC(C)       &trans   &trans                        &kp LG(BSPC)   &kp LA(BSPC)   &trans     &kp LA(DEL)     &kp LG(DEL)     &trans
         &trans           &trans               &trans          &trans   &trans   &trans      &trans   &trans                                                   &kp C_BRI_DN    &kp C_BRI_UP
            >;
        };

        // 設定
        //   上段: Bluetooth の接続先の切り替え  
        //   中段: 接続先との切断
        //   右下の2キー: ペアリングの削除
        //   右親指: ZMK Studio のロック解除
        layer_5 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &bt BT_DISC 0    &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans           &trans          &trans          &trans          &trans          &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &studio_unlock                                                   &bt BT_CLR      &bt BT_CLR_ALL
            >;
        };

        // スクロール
        layer_6 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans
            >;
        };
    };
};
