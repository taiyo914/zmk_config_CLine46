#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// タップとホールドの判定
// - 200ms 以上押したときにホールドになる
// - 200ms 以内に別のキーが押されてもホールド判定はしない 
// - 200ms 以内に素早く長押しするとタップのキーを押し続ける

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

// 1回押して離すと、次の1キーにだけ効く修飾キー
// - 次のキーを押した時点で修飾キーを離す。速く打っても2文字目には効かない
&sk {
    quick-release;
};

/ {
    macros {
        // Shift で送る文字を変えるための macro 
        // 先に Shift を外してから、引数のキーを送る
        // 同時に送ると、PC が Shift ありの文字を入力することがある

        unshifted: unshifted {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp RSHIFT>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        // Shift の有無で送る文字を変えるキー。Shift ありのときは Shift を外して送る

        semi_colon: semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&unshifted SEMI>;    // 単押し ':' / Shift ';'
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Tab と Q を同時に押すと Esc
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        // 左親指の Space とその右隣を同時に押している間、レイヤー3（設定）に入る
        combo_settings {
            timeout-ms = <50>;
            key-positions = <40 41>;
            bindings = <&mo 3>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 文字入力
        layer_0 {
            bindings = <
&kp TAB      &kp Q       &kp W        &kp E      &kp R            &kp T                                    &kp Y             &kp U   &kp I       &kp O     &kp P          &kp BSPC
&kp LCTRL    &kp A       &kp S        &kp D      &kp F            &kp G                                    &kp H             &kp J   &kp K       &kp L     &kp MINUS      &kp RET
&kp LSHIFT   &kp Z       &kp X        &kp C      &kp V            &kp B                                    &kp N             &kp M   &kp COMMA   &kp DOT   &kp SLASH      &kp RSHIFT
             &kp LCTRL   &kp ESC      &kp LALT   &mt LGUI LANG2   &lt 1 SPACE   &sk LSHIFT      &mo 2      &mt RGUI LANG1                                  &kp C_VOL_DN   &kp C_VOL_UP
            >;
        };

        // 数字と移動
        //   右手: 数字
        //   左手: 矢印
        //   V と C: スクリーンショット
        //   右下の2キー: 画面の明るさ
        layer_1 {
            bindings = <
&trans   &kp LS(LEFT)   &kp LA(LEFT)   &kp UP               &kp LA(RIGHT)    &kp LS(RIGHT)                        &kp N0      &kp N1   &kp N2   &kp N3   &trans         &trans
&trans   &kp LG(LEFT)   &kp LEFT       &kp DOWN             &kp RIGHT        &kp LG(RIGHT)                        &kp PLUS    &kp N4   &kp N5   &kp N6   &trans         &trans
&trans   &trans         &trans         &kp LG(LS(LC(N4)))   &kp LG(LS(N2))   &trans                               &kp ASTRK   &kp N7   &kp N8   &kp N9   &trans         &trans
         &trans         &trans         &trans               &trans           &trans          &trans      &trans   &trans                                 &kp C_BRI_DN   &kp C_BRI_UP
            >;
        };

        // 記号
        // 英語の呼び名の頭文字などで位置を決めている
        //   Q ' quote         W " w-quote    E = equal      R ^ raised to the power of   T ~ tilde
        //   A @ at            S * star       D $ dollar     G ` grave
        //   X ! eXclamation   C : colon      V | vertical   B \ backslash
        //   H # hash          N & 'n (and)   L + large      P % percent
        layer_2 {
            bindings = <
&trans   &kp SQT   &kp DQT     &kp EQUAL     &kp CARET   &kp TILDE                        &trans      &kp LPAR   &kp RPAR   &trans     &kp PRCNT   &trans
&trans   &kp AT    &kp ASTRK   &kp DLLR      &trans      &kp GRAVE                        &kp HASH    &kp LBKT   &kp RBKT   &kp PLUS   &trans      &trans
&trans   &trans    &kp EXCL    &semi_colon   &kp PIPE    &kp BSLH                         &kp AMPS    &trans     &trans     &trans     &trans      &trans
         &trans    &trans      &trans        &trans      &trans      &trans      &trans   &trans                                       &trans      &trans
            >;
        };

        // 設定
        //   上段: Bluetooth の接続先の切り替え  
        //   中段: 接続先との切断
        //   右下の2キー: ペアリングの削除
        //   右親指: ZMK Studio のロック解除
        layer_3 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &bt BT_DISC 0    &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans           &trans          &trans          &trans          &trans          &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &studio_unlock                                                   &bt BT_CLR      &bt BT_CLR_ALL
            >;
        };

        // マウス（オートマウスレイヤー）
        layer_4 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &mkp MB4   &trans   &mkp MB5   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &mkp MB1   &mo 5    &mkp MB2   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans     &trans   &trans     &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                                  &trans   &trans
            >;
        };

        // スクロール
        layer_5 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans
            >;
        };
    };
};
