#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

// スクロールキーの調整
// - タップしたとき: (SCROLL_TAP_INTERVAL × 16)ms おきに SCROLL_TAP_COUNT 回スクロールする
// - ホールドとき: 1秒に SCROLL_HOLD_COUNT_PER_SEC 回スクロールする

// SCROLL_TAP_INTERVAL を上げるとゆっくり滑らかに動き、下げると素早くカクっと動く
// 注意: Mac は素早くスクロールするほど大きく動かすので、値を上げると動きは小さく、下げると動きは大きくなる
#define SCROLL_TAP_INTERVAL 3

// 次の値でスクロール量を調節する
#define SCROLL_TAP_COUNT 4            // タップ
#define SCROLL_HOLD_COUNT_PER_SEC 30  // ホールド

#define SCROLL_TAP_COUNT_PER_SEC (1000 / (16 * SCROLL_TAP_INTERVAL) + 1)
#define SCROLL_KEY_UP     &scroll_key MOVE_Y(SCROLL_HOLD_COUNT_PER_SEC) MOVE_Y(SCROLL_TAP_COUNT_PER_SEC)
#define SCROLL_KEY_DOWN   &scroll_key MOVE_Y(-SCROLL_HOLD_COUNT_PER_SEC) MOVE_Y(-SCROLL_TAP_COUNT_PER_SEC)
#define SCROLL_KEY_RIGHT  &scroll_key MOVE_X(SCROLL_HOLD_COUNT_PER_SEC) MOVE_X(SCROLL_TAP_COUNT_PER_SEC)
#define SCROLL_KEY_LEFT   &scroll_key MOVE_X(-SCROLL_HOLD_COUNT_PER_SEC) MOVE_X(-SCROLL_TAP_COUNT_PER_SEC)

// タップとホールドの判定
// - 200ms 以上押したときにホールドになる
// - 200ms 以内に別のキーが押されてもホールド判定はしない
// - 200ms 以内に素早く長押しするとタップのキーを押し続ける

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

// 1回押して離すと、次の1キーにだけ効く修飾キー
// - 次のキーを押した時点で修飾キーを離す。速く打っても2文字目には効かない
&sk {
    quick-release;
};

// スクロールしたとき、オートマウスレイヤー（レイヤー4）の残り時間を10秒に戻す
// - レイヤー番号と時間は CLine46_R.overlay の設定とそろえる
&msc_input_listener {
    input-processors = <&zip_temp_layer 4 10000>;
};

/ {
    macros {
        // Shift で送る文字を変えるための macro
        // 先に Shift を外してから、引数のキーを送る
        // 同時に送ると、PC が Shift ありの文字を入力することがある

        unshifted: unshifted {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp RSHIFT>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        // スクロールキーを短く押したときの動き

        scroll_tap: scroll_tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <(SCROLL_TAP_COUNT * SCROLL_TAP_INTERVAL * 16 + 8)>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &msc MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        // スクロールキー
        // - 200ms 以内に離すとタップ、それより長いとホールドになる
        // - ホールドのスクロールは、押してから 200ms たった時点で始まる

        scroll_key: scroll_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&msc>, <&scroll_tap>;
        };

        // Ctrl キー。単押しで Esc、ホールドで Ctrl
        // - 200ms 以内に離すとタップ、別のキーを押した時点でホールドになる

        ctrl_esc: ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // 文字キーに修飾キーを持たせる設定（例: A を長押しで Ctrl）。単押しで文字、長押しで修飾キー
        // - 200ms 以上押したとき、または押している間に別のキーを押して離したときに、修飾キーになる
        // - 直前のキーを打ってから 150ms 以内に押したときは、文章を打っている途中とみなして必ず文字になる
        // - 1回打ってから 200ms 以内にもう一度押して押し続けると、文字を連続で入力する
        home_mod: home_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Shift の有無で送る文字を変えるキー。Shift ありのときは Shift を外して送る

        semi_colon: semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&unshifted SEMI>;    // 単押し ':' / Shift ';'
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // マウスレイヤーの - キー。単押しで -、押している間はスクロールレイヤー
        // - 200ms 以内に離すとタップ。押している間に別のキーを押して離したときは、200ms たっていなくてもホールドになる

        minus_scroll: minus_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // 左親指の Space とその右隣を同時に押している間、レイヤー3（設定）に入る
        combo_settings {
            timeout-ms = <50>;
            key-positions = <40 41>;
            bindings = <&mo 3>;
            layers = <0>;
        };

        // マウスレイヤーで J と K を同時に押すと、ブラウザなどで前のページに戻る
        combo_back {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp MB4>;
            layers = <4>;
        };

        // マウスレイヤーで K と L を同時に押すと、ブラウザなどで次のページに進む
        combo_forward {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp MB5>;
            layers = <4>;
        };

        // マウスレイヤーで U と I を同時に押すと、Cmd+W でタブを閉じる
        combo_close_tab {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp LG(W)>;
            layers = <4>;
        };

        // マウスレイヤーで I と O を同時に押すと、Cmd+T で新しいタブを開く
        combo_new_tab {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp LG(T)>;
            layers = <4>;
        };

        // マウスレイヤーで J と K と L を同時に押すと、Mac の範囲指定スクリーンショットをクリップボードにコピーする（Cmd+Ctrl+Shift+4）
        combo_mac_screenshot {
            timeout-ms = <50>;
            key-positions = <19 20 21>;
            bindings = <&kp LG(LC(LS(N4)))>;
            layers = <4>;
        };

        // マウスレイヤーで U と I と O を同時に押すと、Shottr のスクリーンショットを撮る（Cmd+Shift+2）
        combo_shottr_screenshot {
            timeout-ms = <50>;
            key-positions = <7 8 9>;
            bindings = <&kp LG(LS(N2))>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 文字入力
        layer_0 {
            bindings = <
&mt LALT TAB          &kp Q      &kp W       &kp E      &kp R            &kp T                                    &kp Y             &kp U   &kp I       &kp O     &kp P          &kp BSPC
&ctrl_esc LCTRL ESC   &home_mod LCTRL A   &kp S       &kp D      &kp F            &kp G                                    &kp H             &kp J   &kp K       &kp L     &kp MINUS      &kp RET
&kp LSHIFT            &kp Z      &kp X       &kp C      &kp V            &kp B                                    &kp N             &kp M   &kp COMMA   &kp DOT   &kp SLASH      &kp RSHIFT
                      &kp ESC     &trans      &kp LALT   &mt LALT LANG2   &lt 1 SPACE   &mt LGUI LANG2  &mt RGUI LANG2   &lt 2 LANG1                                     &kp C_VOL_DN   &kp C_VOL_UP
            >;
        };

        // 数字と移動
        //   右手: 数字（中段 H J K L - が 0〜4、上段 Y U I O P が 5〜9）
        //         演算記号（N + / M - / , *）。. と / は文字入力レイヤーのまま
        //   左手: 矢印
        //   Q: カーソルの左の1単語を削除（Option+Backspace）  T: カーソルの右の1単語を削除（Option+Delete）
        //   右下の2キー: 画面の明るさ
        layer_1 {
            bindings = <
&trans   &kp LA(BSPC)   &kp LA(LEFT)   &kp UP     &kp LA(RIGHT)   &kp LA(DEL)                          &kp N5     &kp N6      &kp N7      &kp N8   &kp N9   &trans
&trans   &kp LG(LEFT)   &kp LEFT       &kp DOWN   &kp RIGHT       &kp LG(RIGHT)                        &kp N0     &kp N1      &kp N2      &kp N3   &kp N4   &trans
&trans   &trans         &trans         &trans     &trans          &trans                               &kp PLUS   &kp MINUS   &kp ASTRK   &trans   &trans   &trans
         &trans         &trans         &trans     &trans          &trans          &trans      &trans   &trans                              &kp C_BRI_DN   &kp C_BRI_UP
            >;
        };

        // 記号
        // 英語の呼び名の頭文字などで位置を決めている
        //   Q ' quote         W " w-quote    E = equal      R ^ raised to the power of   T ~ tilde
        //   A @ at            S * star       D $ dollar     G ` grave
        //   X ! eXclamation   C : colon      V | vertical   B \ backslash
        //   H # hash          N & 'n (and)   M % mod        P + plus
        layer_2 {
            bindings = <
&trans   &kp SQT   &kp DQT     &kp EQUAL     &kp CARET   &kp TILDE                        &trans      &kp LPAR   &kp RPAR   &trans     &kp PLUS    &trans
&trans   &kp AT    &kp ASTRK   &kp DLLR      &trans      &kp GRAVE                        &kp HASH    &kp LBKT   &kp RBKT   &trans     &trans      &trans
&trans   &trans    &kp EXCL    &semi_colon   &kp PIPE    &kp BSLH                         &kp AMPS    &kp PRCNT  &trans     &trans     &trans      &trans
         &trans    &trans      &trans        &trans      &trans      &trans      &trans   &trans                                       &trans      &trans
            >;
        };

        // 設定
        //   上段: Bluetooth の接続先の切り替え
        //   中段: 接続先との切断
        //   右下の2キー: ペアリングの削除
        //   右親指: ZMK Studio のロック解除
        //   shiftの位置: 押した側を書き込み待ちの状態にする（リセットボタンを2回押すのと同じ）
        //   C: Bluetooth の接続状況を LED で表示する（connection）
        //   B: 電池の残量を LED で表示する（battery）
        layer_3 {
            bindings = <
&trans        &trans   &trans   &trans     &trans   &trans                        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans
&trans        &trans   &trans   &trans     &trans   &trans                        &bt BT_DISC 0   &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4   &trans
&bootloader   &trans   &trans   &ind_con   &trans   &ind_bat                      &trans          &trans          &trans          &trans          &trans          &bootloader
              &trans   &trans   &trans     &trans   &trans   &trans    &trans   &studio_unlock                                                  &bt BT_CLR      &bt BT_CLR_ALL
            >;
        };

        // マウス（オートマウスレイヤー）
        // 注意：変更したときは CLine46_R.conf の &zip_temp_layer も一緒に変更する
        //   I: 画面が下にスクロール  K: 画面が上にスクロール
        //   U: 画面が右にスクロール  O: 画面が左にスクロール
        //      ※ Mac の「ナチュラルなスクロール」を有効にしていると、スクロール方向と移動する向きが逆になる
        //   J: 左クリック  L: 右クリック
        //   ,: ←  .: →（YouTube などで動画を巻き戻す・早送りするため）
        //   J と K の同時押し: 戻る  K と L の同時押し: 進む（combos で設定）
        //   U と I の同時押し: タブを閉じる（Cmd+W）  I と O の同時押し: 新しいタブ（Cmd+T）（combos で設定）
        //   J と K と L の同時押し: Mac のスクリーンショット（Cmd+Ctrl+Shift+4）（combos で設定）
        //   U と I と O の同時押し: Shottr のスクリーンショット（Cmd+Shift+2）（combos で設定）
        //   -: 単押しで -、押している間スクロールレイヤー
        layer_4 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans           SCROLL_KEY_RIGHT   SCROLL_KEY_DOWN   SCROLL_KEY_LEFT   &trans      &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans           &mkp MB1           SCROLL_KEY_UP     &mkp MB2          &minus_scroll 5 MINUS   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans           &trans             &kp LEFT          &kp RIGHT         &trans      &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                                                                  &trans   &trans
            >;
        };

        // スクロール
        //   入り方: マウスレイヤーで - を押し続ける
        //   入っている間はボールでスクロールする
        //   I: Cmd+↑  K: Cmd+↓（Karabiner でアプリごとのタブ切り替えに変えている）
        //   J: コピー（Cmd+C）  L: ペースト（Cmd+V）
        //   O: 元に戻す（Cmd+Z）
        layer_5 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans           &kp LG(UP)     &kp LG(Z)        &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &kp LG(C)        &kp LG(DOWN)   &kp LG(V)        &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                              &trans   &trans
            >;
        };
    };
};
