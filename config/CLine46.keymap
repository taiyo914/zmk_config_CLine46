#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// タップとホールドの判定
// - 200ms 以上押したときにホールドになる
// - 200ms 以内に別のキーが押されてもホールド判定はしない 
// - 200ms 以内に素早く長押しするとタップのキーを押し続ける
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>; 
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 以下は Shift の有無で送る文字を変えるキー。Shift ありのときは Shift を外して送る
        semi_colon: semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;     // 単押し ':' / Shift ';'
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        pipe_bslh: pipe_bslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PIPE>, <&kp BSLH>;      // 単押し '|' / Shift '\'
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        plus_equal: plus_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp EQUAL>;     // 単押し '+' / Shift '='
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbkt_lpar: lbkt_lpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LPAR>;      // 単押し '[' / Shift '('
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rbkt_rpar: rbkt_rpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp RPAR>;      // 単押し ']' / Shift ')'
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 文字入力
        layer_0 {
            bindings = <
&kp TAB      &kp Q       &kp W        &kp E      &kp R            &kp T                                               &kp Y             &kp U         &kp I       &kp O     &kp P       &kp BSPC
&kp LCTRL    &kp A       &kp S        &kp D      &kp F            &kp G                                               &kp H             &kp J         &kp K       &kp L     &kp MINUS   &kp RET
&kp LSHIFT   &kp Z       &kp X        &kp C      &kp V            &kp B                                               &kp N             &kp M         &kp COMMA   &kp DOT   &kp SLASH   &kp RSHIFT
             &kp LCTRL   &kp RSHIFT   &kp LALT   &mt LGUI LANG2   &lt 2 SPACE   &lt 3 SPACE      &mt RGUI LANG1   &lt 1 LANG1                                         &kp RALT    &kp HOME
            >;
        };

        // 数字と記号
        layer_1 {
            bindings = <
&trans   &kp N6     &kp N7      &kp N8     &kp N9        &kp N0                                &kp AT        &lbkt_lpar    &rbkt_rpar   &kp LBRC      &kp RBRC    &trans
&trans   &kp N1     &kp N2      &kp N3     &kp N4        &kp N5                                &kp HASH      &kp GRAVE     &kp ASTRK    &kp GT        &kp MINUS   &trans
&trans   &kp DLLR   &kp CARET   &kp AMPS   &kp PLUS      &kp PRCNT                             &kp SQT       &semi_colon   &pipe_bslh   &plus_equal   &kp EXCL    &trans
         &trans     &trans      &trans     &trans        &trans      &trans      &trans        &trans                                                  &trans      &trans
            >;
        };

        // カーソルとマウス（オートマウスレイヤー）
        layer_2 {
            bindings = <
&trans   &kp LS(LEFT)   &kp LA(LEFT)   &kp UP     &kp LA(RIGHT)   &kp LS(RIGHT)                         &trans      &mkp MB4   &trans    &mkp MB5   &trans   &trans
&trans   &kp LG(LEFT)   &kp LEFT       &kp DOWN   &kp RIGHT       &kp LG(RIGHT)                         &kp BSPC    &mkp MB1   &mo 3     &mkp MB2   &trans   &trans
&trans   &trans         &trans         &trans     &trans          &trans                                &trans      &trans     &trans    &trans     &trans   &trans
         &trans         &trans         &trans     &trans          &trans          &trans      &trans    &trans                                      &trans   &trans
            >;
        };


        // スクロール・Bluetooth の切り替え・ZMK Studio のロック解除
        layer_3 {
            bindings = <
&bt BT_CLR       &trans   &trans         &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans   &trans
&bt BT_CLR_ALL   &trans   &bt BT_SEL 4   &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans   &trans
&trans           &trans   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                                &trans   &trans   &trans   &trans   &trans   &trans
                 &trans   &bt BT_SEL 0   &trans         &trans         &trans   &trans      &studio_unlock   &trans                     &trans   &trans  
            >;
        };


        layer_4 {
            bindings = <
&trans   &trans   &trans         &trans         &trans         &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &bt BT_SEL 4   &trans         &trans         &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &bt BT_SEL 0   &trans         &trans         &trans   &trans      &trans   &trans                     &trans   &trans 
            >;
        };


        layer_5 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans       
            >;
        };


        layer_6 {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans 
            >;
        };
    };
};